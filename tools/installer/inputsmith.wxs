<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-user MSI for Inputsmith (WiX Toolset v5). Built by `tools/package.ps1`, which runs:
    wix build -arch x64 -ext WixToolset.Util.wixext -d Version=<x.y.z> -d BinDir=<target\release>
              -d DocDir=<repository root> -o <msi> inputsmith.wxs
  Installs to %LOCALAPPDATA%\Programs\inputsmith, no administrator rights needed. Settings in
  %APPDATA%\inputsmith are never touched.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Inputsmith"
           Manufacturer="Inputsmith contributors"
           Version="$(Version)"
           UpgradeCode="D2EF50AA-DDB3-4847-B8F8-5ECE9BD813EB"
           Scope="perUser"
           Compressed="yes">
    <!-- Same-version upgrades let a release replace its release candidate (both are MSI version x.y.z). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of Inputsmith is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/IngilizAdam/inputsmith" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsDir" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="inputsmith">
          <!-- Files in the user profile need an HKCU value as key path (ICE38). -->
          <Component Id="Programs" Guid="0347F20A-3B9B-4E37-9CB1-107418292D3D">
            <RegistryKey Root="HKCU" Key="Software\Inputsmith" ForceDeleteOnUninstall="yes">
              <RegistryValue Name="InstallDir" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
            </RegistryKey>
            <File Id="GuiExe" Source="$(BinDir)\inputsmith-gui.exe" />
            <File Id="AgentExe" Source="$(BinDir)\inputsmith-agent.exe" />
            <File Id="CliExe" Source="$(BinDir)\inputsmith.exe" />
            <File Id="Readme" Source="$(DocDir)\README.md" />
            <File Id="License" Source="$(DocDir)\LICENSE" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            <RemoveFolder Id="RemoveProgramsDir" Directory="ProgramsDir" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
      <!-- The agent's log (at most ~2 MB, see crates/agent/src/logfile.rs); removed on uninstall. -->
      <Directory Id="LogDir" Name="inputsmith">
        <Component Id="Logs">
          <RegistryValue Root="HKCU" Key="Software\Inputsmith" Name="LogDir" Type="string" Value="[LogDir]"
                         KeyPath="yes" />
          <RemoveFile Id="RemoveLogs" Name="*.log" On="uninstall" />
          <RemoveFolder Id="RemoveLogDir" On="uninstall" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenu" Name="Inputsmith" Description="Settings for Logitech mice and keyboards"
                  Target="[INSTALLFOLDER]inputsmith-gui.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\Inputsmith" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main">
      <ComponentRef Id="Programs" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="Logs" />
    </Feature>

    <!-- Running copies keep the files and folders locked. End them before Windows Installer checks for
         files in use (it would ask the user to close them) and before an old version is removed. The
         GUI restarts the agent, so it goes first. Each is waited for: a process that is still exiting
         would show up in the files-in-use check. -->
    <SetProperty Id="WixQuietExecCmdLine" Sequence="execute" Before="CloseRunningApp"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;Get-Process inputsmith-gui -ErrorAction SilentlyContinue | Stop-Process -Force -PassThru | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue; Get-Process inputsmith-agent -ErrorAction SilentlyContinue | Stop-Process -Force -PassThru | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue&quot;" />
    <CustomAction Id="CloseRunningApp" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="immediate" Return="ignore" />

    <!-- "Start at login" is a switch in the app (HKCU Run value "inputsmith"); drop it on uninstall. -->
    <SetProperty Id="RemoveAutostart" Sequence="execute" Before="RemoveAutostart"
                 Value="&quot;[System64Folder]reg.exe&quot; delete HKCU\Software\Microsoft\Windows\CurrentVersion\Run /v inputsmith /f" />
    <CustomAction Id="RemoveAutostart" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixQuietExec"
                  Execute="deferred" Impersonate="yes" Return="ignore" />

    <!-- Start the app after installing or upgrading (not for quiet installs). A fresh install also
         turns on "Start at login"; an upgrade keeps the user's choice. -->
    <CustomAction Id="LaunchAppFirstInstall" Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]inputsmith-gui.exe&quot; --enable-autostart" Return="asyncNoWait" />
    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]inputsmith-gui.exe&quot;"
                  Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom Action="CloseRunningApp" Before="InstallValidate" />
      <Custom Action="RemoveAutostart" Before="RemoveFiles"
              Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="LaunchAppFirstInstall" After="InstallFinalize"
              Condition="NOT Installed AND NOT REMOVE AND NOT WIX_UPGRADE_DETECTED AND UILevel &lt;&gt; 2" />
      <Custom Action="LaunchApp" After="LaunchAppFirstInstall"
              Condition="NOT Installed AND NOT REMOVE AND WIX_UPGRADE_DETECTED AND UILevel &lt;&gt; 2" />
    </InstallExecuteSequence>
  </Package>
</Wix>
